{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File ${CLAUDE_CONFIG_DIR}/hooks/pre-commit-secret-scan.ps1"
          }
        ],
        "description": "Scan staged files for secrets before a git commit. Blocking (exit 1) on a hit; silent no-op for every non-commit Bash command."
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File ${CLAUDE_CONFIG_DIR}/hooks/post-edit-format.ps1"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File ${CLAUDE_CONFIG_DIR}/hooks/post-edit-console-log.ps1"
          }
        ],
        "description": "On .ts/.tsx/.js/.jsx edits: run prettier --write then tsc --noEmit, and warn on console.log. Never blocks (always exit 0)."
      }
    ]
  }
}
