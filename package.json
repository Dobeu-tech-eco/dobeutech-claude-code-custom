{
  "name": "@jwdobeutechsolutions/dobeutech-claude-code-custom",
  "version": "2.0.0",
  "description": "Centralized AI CLI configurations for Claude Code, OpenAI Codex CLI, and Google Gemini CLI — agents, skills, commands, hooks, rules, and MCP servers from a single source of truth",
  "author": "jwdobeutechsolutions",
  "license": "MIT",
  "main": "scripts/install.js",
  "bin": {
    "claude-config": "bin/claude-config.js",
    "ai-config": "bin/ai-config.js"
  },
  "scripts": {
    "postinstall": "node scripts/install.js --target claude",
    "install:all": "node scripts/install.js --target all",
    "install:claude": "node scripts/install.js --target claude",
    "install:codex": "node scripts/install.js --target codex",
    "install:gemini": "node scripts/install.js --target gemini",
    "verify": "node scripts/verify.js"
  },
  "files": [
    "agents",
    "skills",
    "commands",
    "rules",
    "hooks",
    "mcp-configs",
    "templates",
    "docs",
    "bin",
    "scripts",
    "README.md",
    "CONTRIBUTING.md",
    "CLAUDE.md"
  ],
  "keywords": [
    "claude-code",
    "codex-cli",
    "gemini-cli",
    "ai-config",
    "agents",
    "skills",
    "commands",
    "hooks",
    "mcp",
    "full-stack",
    "development",
    "claude",
    "codex",
    "gemini",
    "ai",
    "configuration"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dobeutech/dobeutech-claude-code-custom.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
